# Opcional: descomente e preencha para usar outro projeto Firebase.
# Sem essas variáveis, a aplicação mantém a configuração pública original.
# Copie este arquivo para .env.local e reinicie npm start após editar.
# REACT_APP_FIREBASE_API_KEY=
# REACT_APP_FIREBASE_AUTH_DOMAIN=
# REACT_APP_FIREBASE_PROJECT_ID=
# REACT_APP_FIREBASE_STORAGE_BUCKET=
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
# REACT_APP_FIREBASE_APP_ID=
